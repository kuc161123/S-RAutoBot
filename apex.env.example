# Put real values directly in Railway Variables. Never commit them.
APEX_MODE=shadow
APEX_LIVE_ENABLED=false
APEX_MIGRATION_VERIFIED=false
APEX_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,LINKUSDT
# Dynamic mode discovers eligible liquid USDT perpetuals; APEX_SYMBOLS is only
# the explicit static-mode list. Target 50 is not a forced minimum.
APEX_UNIVERSE_MODE=dynamic
APEX_UNIVERSE_SIZE=50
APEX_UNIVERSE_MIN_TURNOVER_USDT=20000000
APEX_UNIVERSE_MAX_SPREAD_BPS=10
APEX_UNIVERSE_MIN_DEPTH_USDT=25000
APEX_SHADOW_EQUITY=10000
APEX_SCAN_SECONDS=60
# Reuse existing private Railway references; do not paste URLs into Git.
DATABASE_URL=
REDIS_URL=
BYBIT_API_KEY=
BYBIT_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=AutotradingBot222_bot
TELEGRAM_ALLOWED_USER_IDS=REPLACE_WITH_YOUR_NUMERIC_TELEGRAM_USER_ID
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
APEX_AI_DAILY_CALLS=60
APEX_AI_MAX_OUTPUT_TOKENS=1800
# Optional read-only Drive references; account needs Viewer access to these files.
APEX_GOOGLE_SERVICE_ACCOUNT_JSON=
APEX_DRIVE_FILE_IDS=
# Optional external advisory feed; cannot override the native risk policy.
APEX_CONTEXT_FEED_URL=
